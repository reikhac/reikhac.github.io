const CA={COURSE:'CS25C12 - Algorithms',TZ:'Asia/Kolkata',SHEETS:{assignments:['ID','Title','Unit','Description','DueDate','MaxMarks','Rubric','Status','CreatedAt'],submissions:['ID','AssignmentID','AssignmentTitle','Name','Roll','Answer','DriveLink','SubmittedAt','ReceiptHash','DraftMarks','AIFeedback','Status','FinalMarks','FacultyFeedback','ReleasedAt'],marks:['SubmissionID','AssignmentTitle','Name','Roll','Marks','MaxMarks','Feedback','ApprovedAt']}};
function doGet(e){const p=e&&e.parameter||{};let r;try{if(p.action==='assignments'){r={success:true,assignments:caPublicAssignments_()}}else if(typeof getExitTicketDashboardData_==='function'){r=getExitTicketDashboardData_()}else{r={success:true,service:'KCET Class Agent',course:CA.COURSE}}}catch(x){r={success:false,error:String(x.message||x),groups:[]}}const b=JSON.stringify(r),c=String(p.callback||'');if(c&&/^[A-Za-z_$][0-9A-Za-z_$]*$/.test(c))return ContentService.createTextOutput(c+'('+b+');').setMimeType(ContentService.MimeType.JAVASCRIPT);return ContentService.createTextOutput(b).setMimeType(ContentService.MimeType.JSON)}
function doPost(e){let r;try{const raw=e&&e.parameter&&e.parameter.payload;if(!raw)throw Error('Missing payload');r=caDispatch_(JSON.parse(raw))}catch(x){r={success:false,error:String(x.message||x)}}const safe=JSON.stringify(r).replace(/</g,'\\u003c');return HtmlService.createHtmlOutput('<!doctype html><html><body><script>parent.postMessage({type:"classAgentResponse",payload:'+safe+'},"*");</script>Processed</body></html>').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL)}
function setupClassAgent(){const p=PropertiesService.getScriptProperties();let id=p.getProperty('SPREADSHEET_ID'),ss=id?SpreadsheetApp.openById(id):SpreadsheetApp.create('KCET Class Agent - CS25C12');if(!id)p.setProperty('SPREADSHEET_ID',ss.getId());Object.keys(CA.SHEETS).forEach(k=>{const n=k==='assignments'?'CA Assignments':k==='submissions'?'CA Submissions':'CA Marks';let s=ss.getSheetByName(n);if(!s)s=ss.insertSheet(n);if(!s.getLastRow()){s.appendRow(CA.SHEETS[k]);s.setFrozenRows(1);s.getRange(1,1,1,CA.SHEETS[k].length).setFontWeight('bold')}});if(!p.getProperty('CA_DRIVE_FOLDER_ID')){const f=DriveApp.createFolder('KCET Class Agent - CS25C12 Submissions');p.setProperty('CA_DRIVE_FOLDER_ID',f.getId())}Logger.log('Setup complete: '+ss.getUrl());Logger.log('Add GEMINI_API_KEY and FACULTY_PASSWORD_SHA256 in Script Properties.')}
function caDispatch_(p){switch(p.action){case'login':return caLogin_(p.password);case'createAssignment':caAuth_(p.token);return caCreate_(p);case'submit':return caSubmit_(p);case'ask':return{success:true,answer:caGemini_('You are KCET Class Agent for undergraduate CS25C12 Algorithms. Explain concepts clearly with examples and pseudocode, encourage learning, do not fabricate references, redirect unrelated questions to Algorithms. Question: '+String(p.question||'').slice(0,2000))};case'facultySubmissions':caAuth_(p.token);return{success:true,submissions:caSubmissions_()};case'evaluate':caAuth_(p.token);return caEvaluate_(p.submissionId);case'approve':caAuth_(p.token);return caApprove_(p);case'releasedMark':return caReleased_(p);default:throw Error('Unknown action')}}
function caDb_(){const id=PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');if(!id)throw Error('Run setupClassAgent() first');return SpreadsheetApp.openById(id)}
function caSh_(n){const s=caDb_().getSheetByName(n);if(!s)throw Error('Missing '+n+'; run setupClassAgent()');return s}
function caRows_(n){return caSh_(n).getDataRange().getValues()}
function caPublicAssignments_(){return caRows_('CA Assignments').slice(1).filter(r=>r[7]==='Published').map(r=>({id:String(r[0]),title:String(r[1]),unit:String(r[2]),description:String(r[3]),dueDate:String(r[4]),maxMarks:Number(r[5])})).reverse()}
function caCreate_(p){const t=String(p.title||'').trim(),d=String(p.description||'').trim(),due=String(p.dueDate||''),m=Number(p.maxMarks);if(!t||!d||!due||!Number.isFinite(m)||m<1||m>100)throw Error('Enter title, instructions, due date and marks (1–100)');const id=Utilities.getUuid();caSh_('CA Assignments').appendRow([id,t,String(p.unit||'Unit I'),d,due,m,String(p.rubric||'Correctness, explanation, complexity and presentation'),'Published',new Date()]);return{success:true,id}}
function caSubmit_(p){const name=String(p.name||'').trim(),roll=String(p.roll||'').trim(),aid=String(p.assignmentId||''),answer=String(p.answer||'').trim(),externalLink=String(p.driveLink||'').trim();if(!name||!roll||!aid||(!answer&&!externalLink))throw Error('Enter name, roll number, assignment and answer or Drive link');if(name.length>100||roll.length>40||answer.length>12000)throw Error('Input too long');if(externalLink&&!/^https:\/\/drive\.google\.com\//i.test(externalLink))throw Error('Use a Google Drive share link');const a=caPublicAssignments_().find(x=>x.id===aid);if(!a)throw Error('Assignment is not active');const receipt=Utilities.getUuid().replace(/-/g,'').slice(0,16).toUpperCase(),id=Utilities.getUuid();const folderId=PropertiesService.getScriptProperties().getProperty('CA_DRIVE_FOLDER_ID');if(!folderId)throw Error('Drive folder not configured. Run setupClassAgent() first.');const fileName=(roll+'_'+a.title+'_'+Utilities.formatDate(new Date(),CA.TZ,'yyyyMMdd_HHmmss')+'.txt').replace(/[\\/:*?"<>|]/g,'_');const content='KCET Class Agent — '+CA.COURSE+'\nAssignment: '+a.title+'\nStudent: '+name+'\nRoll number: '+roll+'\nSubmitted: '+new Date()+'\n\nStudent answer:\n'+(answer||'[No typed answer; see shared file link below.]')+'\n\nStudent-provided Drive link (faculty must verify access):\n'+(externalLink||'Not supplied');const file=DriveApp.getFolderById(folderId).createFile(fileName,content,MimeType.PLAIN_TEXT);caSh_('CA Submissions').appendRow([id,aid,a.title,name,roll,answer,file.getUrl(),new Date(),caHash_(receipt+'|'+roll.toLowerCase()),'','','Submitted','','','']);return{success:true,receiptCode:receipt}}
function caLogin_(pw){const expected=PropertiesService.getScriptProperties().getProperty('FACULTY_PASSWORD_SHA256');if(!expected)throw Error('Faculty password is not configured; follow CLASS_AGENT_SETUP.md');if(!pw||caHash_(pw)!==expected)throw Error('Incorrect faculty password');const token=Utilities.getUuid()+Utilities.getUuid();CacheService.getScriptCache().put('ca_'+caHash_(token),'1',21600);return{success:true,token}}
function caAuth_(t){if(!t||CacheService.getScriptCache().get('ca_'+caHash_(String(t)))!=='1')throw Error('Faculty session expired; sign in again')}
function caMax_(aid){const r=caRows_('CA Assignments').slice(1).find(x=>String(x[0])===aid);return r?Number(r[5]):0}
function caSubmissions_(){return caRows_('CA Submissions').slice(1).filter(r=>r[0]).map(r=>({id:String(r[0]),assignmentTitle:String(r[2]),name:String(r[3]),roll:String(r[4]),answer:String(r[5]),driveLink:String(r[6]),submittedAt:r[7] instanceof Date?Utilities.formatDate(r[7],CA.TZ,'dd MMM yyyy HH:mm'):String(r[7]),draftMarks:r[9]===''?'':Number(r[9]),aiFeedback:String(r[10]),status:String(r[11]),maxMarks:caMax_(String(r[1]))})).reverse()}
function caFind_(id){const s=caSh_('CA Submissions'),r=s.getDataRange().getValues();for(let i=1;i<r.length;i++)if(String(r[i][0])===String(id))return{s,row:i+1,data:r[i]};throw Error('Submission not found')}
function caEvaluate_(id){const x=caFind_(id),r=x.data,all=caRows_('CA Assignments').slice(1),a=all.find(v=>String(v[0])===String(r[1]));if(!a)throw Error('Assignment not found');const max=Number(a[5]);const prompt='Evaluate this undergraduate Algorithms submission against the rubric. Give provisional score 0-'+max+', evidence-based feedback, strengths and gaps. If only a Drive link is supplied, do not claim to have opened it; say faculty must inspect it and assign no assumed score. Return only JSON {"score":number,"feedback":"...","strengths":"...","gaps":"..."}. Assignment: '+a[1]+' Instructions: '+a[3]+' Rubric: '+a[6]+' Answer: '+r[5]+' Drive link (not opened): '+r[6];const raw=caGemini_(prompt),clean=raw.replace(/^\x60{3}json\s*|\x60{3}\s*$/g,''),v=JSON.parse(clean),score=Math.max(0,Math.min(max,Number(v.score)));if(!Number.isFinite(score))throw Error('AI score invalid');const fb='PROVISIONAL AI FEEDBACK — '+(v.feedback||'')+'\nStrengths: '+(v.strengths||'')+'\nGaps: '+(v.gaps||'');x.s.getRange(x.row,10).setValue(score);x.s.getRange(x.row,11).setValue(fb);x.s.getRange(x.row,12).setValue('AI Draft — Faculty Review Required');return{success:true,score,feedback:fb}}
function caApprove_(p){const x=caFind_(p.submissionId),r=x.data,max=caMax_(String(r[1])),m=Number(p.marks);if(!Number.isFinite(m)||m<0||m>max)throw Error('Marks must be between 0 and '+max);const fb=String(p.feedback||r[10]||'Faculty approved');x.s.getRange(x.row,12).setValue('Released');x.s.getRange(x.row,13).setValue(m);x.s.getRange(x.row,14).setValue(fb);x.s.getRange(x.row,15).setValue(new Date());caSh_('CA Marks').appendRow([r[0],r[2],r[3],r[4],m,max,fb,new Date()]);return{success:true}}
function caReleased_(p){const roll=String(p.roll||'').trim(),receipt=String(p.receiptCode||'').trim();if(!roll||!receipt)throw Error('Enter roll number and receipt code');const h=caHash_(receipt+'|'+roll.toLowerCase()),r=caRows_('CA Submissions').slice(1).find(x=>String(x[4]).toLowerCase()===roll.toLowerCase()&&String(x[8])===h);if(!r)throw Error('No matching record; check both values');if(r[11]!=='Released')return{success:true,released:false};return{success:true,released:true,assignment:String(r[2]),marks:Number(r[12]),maxMarks:caMax_(String(r[1])),feedback:String(r[13])}}
function caGemini_(prompt){const key=PropertiesService.getScriptProperties().getProperty('GEMINI_API_KEY');if(!key)throw Error('GEMINI_API_KEY is missing in Script Properties');const url='https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key='+encodeURIComponent(key),res=UrlFetchApp.fetch(url,{method:'post',contentType:'application/json',payload:JSON.stringify({contents:[{parts:[{text:prompt}]}],generationConfig:{temperature:0.2,maxOutputTokens:900}}),muteHttpExceptions:true}),code=res.getResponseCode(),body=JSON.parse(res.getContentText());if(code<200||code>=300)throw Error('Gemini API error '+code+'; check key, access and quota');const out=body.candidates&&body.candidates[0]&&body.candidates[0].content.parts.map(x=>x.text||'').join('');if(!out)throw Error('Gemini returned an empty response');return out.trim()}
function caHash_(s){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(s),Utilities.Charset.UTF_8).map(b=>('0'+(b&255).toString(16)).slice(-2)).join('')}
function printFacultyPasswordHashOnce() {
  const password = 'YourStrongPassword@2026';

  const hash = Utilities.computeDigest(
    Utilities.DigestAlgorithm.SHA_256,
    password,
    Utilities.Charset.UTF_8
  ).map(b => ('0' + (b & 255).toString(16)).slice(-2)).join('');

  console.log(hash);
}
